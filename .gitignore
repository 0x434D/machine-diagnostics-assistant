# Secrets — never commit. Also covered by the gitleaks pre-commit hook (docs/ENGINEERING.md §6).
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
# pki/ holds only what pki-init generates: a certificate without its key is useless and a
# committed keypair is a secret in the repository. Ignore the tree, keep the directory.
pki/*
!pki/.gitkeep
secrets/
# The development issuer's keypair (scripts/mint-token.py). It stands where Zitadel will
# until there is an issuer to stand there; `*.pem` above already covers the two files, and
# the directory is named here so the intent is visible where someone would look for it.
.dev-issuer/

# Build and dependency output
.venv/
__pycache__/
*.pyc
node_modules/
dist/
bin/
obj/
# `make images` / `make sbom` output: OCI tarballs and CycloneDX documents.
build/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local Claude Code overrides (settings.json itself IS committed — it carries the gates)
.claude/settings.local.json

# Worktrees created by EnterWorktree for parallel lanes
.worktrees/

# Scratch volumes the measurement runners and the authenticity proofs bind-mount. Host paths
# because Docker needs one; inside the repo so they are visible while a run is in flight.
.authenticity-queue/
.r1-queue/

# Worktrees for concurrent subagents: real git worktrees, not content of this repository.
.claude/worktrees/
