# Secrets — never commit. Also covered by the gitleaks pre-commit hook (docs/ENGINEERING.md §6).
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
# pki/ holds only what pki-init generates: a certificate without its key is useless and a
# committed keypair is a secret in the repository. Ignore the tree, keep the directory.
pki/*
!pki/.gitkeep
secrets/

# Build and dependency output
.venv/
__pycache__/
*.pyc
node_modules/
dist/
bin/
obj/
# `make images` / `make sbom` output: OCI tarballs and CycloneDX documents.
build/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local Claude Code overrides (settings.json itself IS committed — it carries the gates)
.claude/settings.local.json
