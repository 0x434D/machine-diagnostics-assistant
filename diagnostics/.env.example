# The diagnostics stack's configuration (§10.3). Copy to diagnostics/.env and edit; .env is
# never committed. Every value below is also the default in compose.yml, so an empty .env and
# no .env at all behave identically -- they are listed because a number nobody can find is
# not configuration.
#
# Nothing in this file is shared with the plant stack, and nothing in it ever may be. The
# plant's one privileged action is gated by a secret in *its* .env, checked by the simulator,
# and two identity mechanisms disjoint by construction is what keeps the two-stack split from
# acquiring a second channel across it (§10.5, CLAUDE.md's fifth invariant).
# plant/simulator/tests/test_identity_boundary.py asserts the two configurations share
# nothing, so a later convenience that unified them fails loudly.

# --- Identity (§10.5) ---------------------------------------------------------------------
#
# The issuer's public key, PEM-encoded, read by all four services that validate a token: the
# analysis service, the agent, the MCP server and -- in C#, through the same variable name --
# the edge gateway.
#
# Shipped EMPTY on purpose. A service that was never given a key trusts nothing and refuses
# everything, which is the only resting state that leaves §14's "every diagnostics endpoint
# returns 401" true wherever the setting was forgotten. A default here would be either a
# committed private key's public half -- a credential in the repository -- or a placeholder
# that turns the failure into a puzzle.
#
# The development issuer is a service since M6 (the `issuer` container, §10.5's Zitadel
# stand-in), but the keypair is still scripts/mint-token.py's, because a container cannot
# generate one and hand it to the four validators. Print the public half with:
#
#     cd diagnostics && uv run --frozen python ../scripts/mint-token.py --public-key
#
# and a token to present with `Authorization: Bearer <token>` -- for a curl, where there is
# no login screen to use -- with:
#
#     cd diagnostics && uv run --frozen python ../scripts/mint-token.py --role user
#
# The keypair lands in .dev-issuer/, which is gitignored twice over. `make m1-demo` and the
# other demo targets do all of this for you -- they configure the stack with that issuer's
# keypair and mint their own tokens -- so this only has to be set for a stack you bring up
# yourself. PEM is multi-line: quote it, or keep the key on one line with \n escapes.
#
# **The services verify against this key; they do not fetch the issuer's JWKS document.**
# The issuer serves one at /.well-known/jwks.json -- that is what an issuer offers, and it is
# where a real one's key set would be read from -- but nothing in this stack reads it today.
AUTH_PUBLIC_KEY=

# §10.5's audience check: a token minted for another service in the same estate must not open
# this one. The gateway and the three Python services must agree, which is why they read one
# variable rather than four.
AUTH_AUDIENCE=machine-agent

# The one issuer this application is a client of. §10.5 is emphatic that there is exactly one;
# validating several directly is the alternative it rules out.
AUTH_ISSUER=https://issuer.test/machine-agent

# --- The development issuer (§10.5) -------------------------------------------------------
#
# The other half of the keypair above, and it must be the other half: the issuer signs with
# this and the four services verify with AUTH_PUBLIC_KEY, so a mismatched pair is a login
# that succeeds and an application that then refuses every request.
#
#     cd diagnostics && uv run --frozen python ../scripts/mint-token.py --private-key
#
# Shipped EMPTY for the same reason AUTH_PUBLIC_KEY is: a committed signing key is a
# credential in the repository that mints admin tokens for every checkout of it. Empty and
# the issuer mints nothing and serves an empty key set, which is a login that fails loudly
# rather than one that hands out tokens nothing honours.
ISSUER_PRIVATE_KEY=

# Who may sign in, and as what. There is no user store and no registration (§10.5), so the
# accounts are configuration -- which is also what makes replacing this issuer with a real
# one a configuration change rather than a rewrite. Roles are exactly `admin` and `user`; a
# third value fails at startup.
#
# The two below are compose.yml's development defaults, restated here because a value nobody
# can find is not configuration. They are development passwords and they say so; a stack
# reachable by anyone else needs its own.
ISSUER_USERS={"operator-7":{"password":"operator-development","role":"user"},"quality-lead":{"password":"quality-lead-development","role":"admin"}}

# How long a token is good for. There is no refresh and no revocation, so this is the whole
# of how long a leaked one lasts.
ISSUER_TOKEN_LIFETIME_MINUTES=60

# --- Database credentials -----------------------------------------------------------------
#
# Development defaults, and the shape is deliberate in each case: the gateway holds the only
# connection privileged enough to set the analysis role's password, and the agent's own role
# is created by its first migration as a step that runs under the owner's credential and never
# hands it to the service.
POSTGRES_PASSWORD=diagnostics
ANALYSIS_DB_PASSWORD=analysis
AGENT_DB_PASSWORD=agent

# --- The agent's model (§6) ---------------------------------------------------------------
#
# "scripted" needs no credentials and reaches no network, which is what makes the evaluation
# reproducible and the demo runnable offline. Set to "anthropic" and supply the key below to
# answer with a real model.
AGENT_PROVIDER=scripted
# ANTHROPIC_API_KEY=

# --- Published ports (§10.3) --------------------------------------------------------------
#
# All loopback-only; there is no TLS between containers and this is a local demonstration
# system, which the README says in those words. Override when the host already has something
# on one of them -- nothing else changes, because the demo targets read these too.
GATEWAY_PORT=8080
ANALYSIS_PORT=8000
AGENT_PORT=8001
MCP_PORT=8002
UI_PORT=5173

# The uid/gid the containers run as. Must own the repository's pki/ directory: the gateway
# reads its own private key out of the bind-mounted pki/, and simulator.pki writes those 0600.
# The same value plant/.env carries, for the same reason.
#   HOST_UID=$(id -u)  HOST_GID=$(id -g)
HOST_UID=1000
HOST_GID=1000
