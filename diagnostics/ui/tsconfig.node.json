{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `vitest.setup.ts` runs inside jsdom and shims one browser global for Vega (§7.4),
    // so this project needs the DOM types even though `vite.config.ts` beside it does not.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.setup.ts"]
}
