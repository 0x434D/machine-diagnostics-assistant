# The plant stack's configuration (§10.3). Copy to plant/.env and edit; .env is never
# committed, and this stack holds no secrets -- the only credential material is the
# certificate keypair, which pki-init generates and never leaves the host.
#
# Every value below is also the default in simulator/src/simulator/config.py, so an
# empty .env and no .env at all both behave identically. They are listed because a
# number nobody can find is not configuration.

# The uid/gid the plant's containers run as. Must own the repository's pki/ directory:
# the certificates are a host bind mount so that the R3 matrix can dial the plant from
# the host with the gateway's own identity, and simulator.pki writes private keys 0600.
# Task 7's edge-gateway must run as this same uid to read its own .pfx.
#   HOST_UID=$(id -u)  HOST_GID=$(id -g)
HOST_UID=1000
HOST_GID=1000

# Line
PLANT_TAKT_SECONDS=6.0
PLANT_TAKT_JITTER_SIGMA=0.05
PLANT_REJECT_RATE=0.05

# Determinism (§3.6). The same seed in both plant services, by construction.
PLANT_SEED=20260912

# Clock (§3.2). 33 h is the measured supremum over a year of boot times, not a guess --
# see simulator/src/simulator/clock.py. 700x closes it in ~170 s wall, inside R1's
# 180 s budget.
PLANT_HISTORY_DEPTH_HOURS=33.0
PLANT_CATCHUP_SPEED=700.0

# Images on the wire (§4.4). 320x240 at zlib level 1 clears OPC UA's 65,535 B
# MaxBufferSize -- so chunking is genuinely exercised -- without blowing the catch-up
# wall. See measurements/r4-image-sizes.txt.
PLANT_IMAGE_WIDTH=320
PLANT_IMAGE_HEIGHT=240
PLANT_IMAGE_COMPRESS_LEVEL=1
