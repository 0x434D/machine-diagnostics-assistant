# The plant stack's configuration (§10.3). Copy to plant/.env and edit; .env is never
# committed. Two pieces of credential material live in this stack: the certificate
# keypair, which pki-init generates and never leaves the host, and the fault-injection
# token below -- gated separately from, and sharing nothing with, the diagnostics
# stack's identity mechanism (§10.5; test_identity_boundary.py asserts the two share no
# configuration).
#
# Every value below is also the default in simulator/src/simulator/config.py, so an
# empty .env and no .env at all both behave identically. They are listed because a
# number nobody can find is not configuration.

# The uid/gid the plant's containers run as. Must own the repository's pki/ directory:
# the certificates are a host bind mount so that the R3 matrix can dial the plant from
# the host with the gateway's own identity, and simulator.pki writes private keys 0600.
# Task 7's edge-gateway must run as this same uid to read its own .pfx.
#   HOST_UID=$(id -u)  HOST_GID=$(id -g)
HOST_UID=1000
HOST_GID=1000

# Line
PLANT_TAKT_SECONDS=6.0
PLANT_TAKT_JITTER_SIGMA=0.05
# §3.5's noise floor (D10, closing A16). It decides which parts carry their image into
# the OPC UA event, not how many are rendered -- every part is -- so it moves how much
# the history weighs and not how long catch-up takes. Measured at 25 streams: 183.1 s
# at 0.05 against 182.3 s at 0.015, with image bytes 103 MB against 32 MB.
PLANT_REJECT_RATE=0.015

# Determinism (§3.6). The same seed in both plant services, by construction.
PLANT_SEED=20260912

# Which of §3.5's eight scenarios this boot runs, or 0 for a clean line. Every
# measurement of the noise floor is taken against 0, which is why it is the default: a
# plant that misbehaved unless told not to would make its own baseline unobtainable.
#
# The seed above and this number together are what §3.6 means by "reproduces the run
# exactly", and they are the two fields the ground-truth log's header carries. The log
# itself is on the `plant-ground-truth` volume and is mounted by nothing else, ever --
# a diagnostics container that could read it would be graded against the answer.
PLANT_SCENARIO=0

# Clock (§3.2). 33 h is the measured supremum over a year of boot times, not a guess --
# see simulator/src/simulator/clock.py. 700x closes it in ~170 s wall, inside R1's
# 180 s budget.
PLANT_HISTORY_DEPTH_HOURS=33.0
PLANT_CATCHUP_SPEED=700.0

# Catch-up pacing. asyncua's per-monitored-item notification queue caps at 10,000 and
# silently discards the oldest entry past that, so generation must let the ~10 ms publish
# loop drain between batches. Measured at this batch size; changing either is a decision
# about that cap.
PLANT_CATCHUP_BATCH_SIZE=500
PLANT_CATCHUP_BATCH_PAUSE_SECONDS=0.05

# Images on the wire (§4.4). 320x240 at zlib level 1 clears OPC UA's 65,535 B
# MaxBufferSize -- so chunking is genuinely exercised -- without blowing the catch-up
# wall. See measurements/r4-image-sizes.txt.
PLANT_IMAGE_WIDTH=320
PLANT_IMAGE_HEIGHT=240
PLANT_IMAGE_COMPRESS_LEVEL=1

# Inspection. The model version the simulator expects; the classifier's own /inspect
# response carries the authoritative one into each event.
PLANT_MODEL_VERSION=simulated-1
# Budget for one /truth + /inspect round trip. A request that outlives it is a real
# failure and must surface as one, so this is a number to tune rather than remove.
PLANT_INSPECTION_TIMEOUT_SECONDS=30.0

# Boundary and observability
# How many rows one HistoryRead response carries. The gateway's backfill pages against
# this, so it is the knob that decides how many round trips a 33 h window costs.
PLANT_HISTORY_PAGE_SIZE=1000
# How often simulator.status rewrites its snapshot. Below one takt, so
# `exec python -m simulator.status` is never more than one part behind the ledger.
PLANT_STATUS_INTERVAL_SECONDS=5.0

# The plant HMI (§15). The screen is served by the plant-hmi container; the payload it
# draws is pushed by the simulator itself, in process (D5).
#
# The host port the screen is published on. Override it when the host already has
# something on 5174 -- the diagnostics UI's own default is 5173, and both are run at once
# the first time anyone compares the line with what the diagnostics stack says about it.
PLANT_HMI_PORT=5174
# How often the simulator pushes a frame. Below one takt, so the screen is never a part
# behind the line it draws.
PLANT_HMI_INTERVAL_SECONDS=0.5
# Where the simulator's HMI server binds inside its container. Deliberately not published
# to the host: the simulator publishes exactly one port, 4840. Setting this moves the
# server AND the proxy in front of it -- compose.yml passes the same value to both, and
# plant-hmi renders its nginx configuration from it at start, so there is no second place
# to remember. test_hmi.py pins the default against simulator.config's.
PLANT_HMI_SERVER_HOST=0.0.0.0
PLANT_HMI_SERVER_PORT=8200

# §10.5's shared secret, gating fault injection -- the plant's one privileged action.
# Shipped empty on purpose: an unset token refuses every injection (fail closed) rather
# than leaving the button live for whoever finds the screen. Set it to any string you
# choose before using the panel, and never to a value the diagnostics stack also holds
# -- test_identity_boundary.py checks that the two configurations share nothing.
PLANT_FAULT_INJECTION_TOKEN=
