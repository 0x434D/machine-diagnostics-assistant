# The browser only ever talks to this origin. /api/plant/* is forwarded to the simulator's
# in-process HMI server here and by the Vite dev server in development, so the simulator
# configures no CORS and no URL is baked into the bundle at build time.
#
# This container joins plant-net (to resolve `line-simulator`) and plant-edge (to be
# publishable). It never joins field-net: exactly two containers ever do.
#
# A TEMPLATE, not a conf: ${PLANT_HMI_SERVER_PORT} is filled in at container start by the
# nginx image's own /docker-entrypoint.d/20-envsubst-on-templates.sh, from the environment
# Compose passes. It was a literal 8200 until review pointed out what that made
# `Settings.hmi_server_port` -- a knob that moved the server, left this file proxying to
# where the server used to be, and reported it as a blank screen and a 502 in a log nobody
# was reading. envsubst substitutes only names that are actually set in the environment, so
# nginx's own $http_upgrade, $is_args, $args, $uri and the $plant variables below survive it
# untouched.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's embedded DNS. Naming it, and putting the upstream in a variable, is what
    # stops nginx resolving `line-simulator` once at startup and refusing to start at all
    # when the simulator happens to be down -- which would take the whole page with it,
    # including the part that would have said the plant was unreachable.
    #
    # A variable in proxy_pass also switches off nginx's trailing-slash URI rewriting, so
    # each location captures the remaining path and passes it explicitly.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # An exact-match location, which nginx tries before every regex whatever the order in
    # this file -- so the catch-all below cannot answer an upgrade request as plain HTTP.
    # (The ordering here is for a reader, not for nginx.)
    location = /api/plant/ws {
        set $plant http://line-simulator:${PLANT_HMI_SERVER_PORT};
        proxy_pass $plant/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # The screen holds this open for as long as it is watched. nginx's 60 s default
        # would close it on the minute, and the reconnect would hide that it had.
        proxy_read_timeout 1d;
        # Buffering a push stream turns it back into a wait.
        proxy_buffering off;
    }

    location ~ ^/api/plant/(?<plant_path>.*)$ {
        set $plant http://line-simulator:${PLANT_HMI_SERVER_PORT};
        proxy_pass $plant/$plant_path$is_args$args;
    }

    # Hashed filenames: the content cannot change under a given name, so cache it hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        # index.html is the one file that must NOT be cached: it names which hashed bundle to
        # load, so a cached copy serves yesterday's application from today's server.
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
